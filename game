<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>红蓝前线 · 基地对决</title><style>
*{box-sizing:border-box}body{margin:0;background:#101b20;color:#edf4ef;font:15px system-ui,sans-serif}main{max-width:1200px;margin:auto;padding:26px 22px}header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.eyebrow{font-size:11px;letter-spacing:4px;color:#92aaa7}h1{font-size:29px;margin:7px 0;letter-spacing:3px}button{font:inherit;cursor:pointer;color:inherit;border:1px solid #43565c;background:#213139;border-radius:8px;padding:12px 18px;touch-action:manipulation}button:hover{background:#304751}button:disabled{opacity:.4;cursor:not-allowed}.topactions{display:flex;gap:8px}.status{display:flex;justify-content:space-between;gap:20px;padding:16px 20px;background:#182a30;border:1px solid #30434a;border-radius:12px 12px 0 0}.team{width:34%;font-size:12px}.team b{display:flex;justify-content:space-between;margin-bottom:8px;letter-spacing:1px}.red{text-align:right}.bar{height:5px;background:#344047;border-radius:5px;overflow:hidden}.bar i{display:block;height:100%;background:#61b5f4;transition:width .2s}.red .bar i{background:#ff7769}.clock{text-align:center;color:#c4d4cc;font-variant-numeric:tabular-nums}.clock small{display:block;color:#849b97;font-size:10px;letter-spacing:2px;margin-top:5px}.field{position:relative;overflow:hidden;border:1px solid #30434a}canvas{display:block;width:100%;aspect-ratio:1100/470;background:#273c34}.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#09151baa;text-align:center;backdrop-filter:blur(4px)}.overlay.hidden{display:none}.modal{padding:24px;max-width:440px}.modal h2{font-size:36px;letter-spacing:4px;margin:10px}.modal p{line-height:1.8;color:#c0d0c9}.primary{background:#d8ed92;color:#243024;border:0;font-weight:700;padding:14px 32px}.primary:hover{background:#edffb3}.panel{background:#182a30;border:1px solid #30434a;border-top:0;border-radius:0 0 12px 12px;padding:20px}.resources{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.gold{font-size:25px;color:#e1edaa;font-weight:700}.muted{font-size:12px;color:#93aba7}.units{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.unit{text-align:left;padding:16px;position:relative;min-height:106px}.unit strong{display:block;margin-bottom:8px;font-size:16px}.unit span{font-size:12px;color:#aec0bb;display:block}.unit em{display:block;color:#e3edab;font-size:13px;font-style:normal;margin-top:9px}.key{position:absolute;right:12px;top:12px;color:#738b89;font:11px monospace}.foot{display:flex;justify-content:space-between;gap:15px;color:#839b97;font-size:12px;margin-top:17px}.lane{display:flex;gap:5px}.lane button{font-size:12px;padding:7px 10px}.lane .active{background:#b7cc87;color:#1d302c;border-color:#b7cc87}#notice{color:#d7e4b6;min-height:18px}@media(max-width:650px){main{padding:15px 10px}header{margin-bottom:15px}h1{font-size:23px}.topactions button{padding:9px;font-size:12px}.status{padding:12px;gap:10px}.team{width:37%}.team b{font-size:10px}canvas{aspect-ratio:1100/650}.units{grid-template-columns:1fr 1fr;gap:8px}.unit{padding:12px;min-height:99px}.panel{padding:12px}.foot{font-size:10px}.modal h2{font-size:27px}.modal p{font-size:12px}.resources{gap:8px}.lane button{padding:7px}.eyebrow{font-size:9px}}
</style><main><header><div><div class="eyebrow">MICRO RTS / 01</div><h1>红蓝前线<span style="color:#d6e69b">.</span></h1></div><div class="topactions"><button id="pause">暂停</button><button id="restart">重新开始</button></div></header><section class="status"><div class="team"><b><span>蓝方 · 你的基地</span><span id="bh">2000</span></b><div class="bar"><i id="bb" style="width:100%"></i></div></div><div class="clock"><span id="time">00:00</span><small>基地对决</small></div><div class="team red"><b><span>红方 · 敌军基地</span><span id="rh">2000</span></b><div class="bar"><i id="rb" style="width:100%"></i></div></div></section><div class="field"><canvas id="game" width="1100" height="470" aria-label="红蓝基地战场，三条路线自动交战"></canvas><div class="overlay" id="overlay"><div class="modal"><div class="eyebrow">TACTICAL BASE BATTLE</div><h2 id="title">两座基地，一场对决</h2><p id="intro">你指挥蓝方，红方自动出兵。<br>选择路线、组建部队，突破防线并摧毁敌方基地。</p><button class="primary" id="start">开始战斗 →</button></div></div></div><section class="panel"><div class="resources"><div><span class="gold">◈ <span id="money">180</span></span> <span class="muted" id="income">+12 / 秒</span></div><div class="lane"><button data-lane="0">上路</button><button data-lane="1" class="active">中路</button><button data-lane="2">下路</button></div></div><div class="units"><button class="unit" data-type="0"><small class="key">1</small><strong>▰ 步兵</strong><span>快速部署 · 近距离作战</span><em>◈ 50</em></button><button class="unit" data-type="1"><small class="key">2</small><strong>⌖ 射手</strong><span>远程火力 · 需要前排</span><em>◈ 90</em></button><button class="unit" data-type="2"><small class="key">3</small><strong>▣ 重型坦克</strong><span>重甲先锋 · 高额伤害</span><em>◈ 160</em></button><button class="unit" id="upgrade"><small class="key">4</small><strong>↗ 补给升级</strong><span id="updesc">永久增加每秒收入</span><em id="upcost">◈ 150 · +4 / 秒</em></button></div><div class="foot"><span id="notice">先派坦克承伤，再用射手提供火力。</span><span>1–3 出兵 · 4 升级 · 空格暂停</span></div></section></main><script>
const $=id=>document.getElementById(id),c=$('game'),g=c.getContext('2d');const TYPES=[{hp:100,damage:14,range:28,speed:41,cd:.65,cost:50},{hp:65,damage:19,range:150,speed:30,cd:.95,cost:90},{hp:390,damage:45,range:100,speed:21,cd:1.4,cost:160}];let autoPaused=false,saveTimer=0;let state,units,fx,bases,money,enemyMoney,elapsed,aiTimer,lane=1,level,last=0,spawnCD=0,kills=0;const ys=[160,235,310];function reset(clearSave=true){autoPaused=false;if(clearSave){try{localStorage.removeItem('front-save-v1')}catch{}}state='ready';units=[];fx=[];bases=[2000,2000];money=180;enemyMoney=170;elapsed=0;aiTimer=2;level=0;spawnCD=0;kills=0;$('title').textContent='两座基地，一场对决';$('intro').innerHTML='你指挥蓝方，红方自动出兵。<br>选择路线、组建部队，突破防线并摧毁敌方基地。';$('start').textContent='开始战斗 →';$('overlay').classList.remove('hidden');$('pause').textContent='暂停';ui()}
function spawn(team,type,l){const t=TYPES[type];units.push({...t,maxhp:t.hp,team,type,lane:l,x:team?982:118,y:ys[l]+(Math.random()-.5)*18,cool:.2,flash:0})}function recruit(type){if(state!=='play'||spawnCD>0||units.filter(u=>!u.team).length>=60)return;const t=TYPES[type];if(money<t.cost)return;money-=t.cost;spawn(0,type,lane);spawnCD=.24;ui()}function upgrade(){if(state!=='play'||level>=5||money<150+level*100)return;money-=150+level*100;level++;ui()}function pause(){if(state==='play'){state='paused';$('title').textContent='战斗已暂停';$('intro').textContent='前线正在等待你的指令。';$('start').textContent='继续战斗 →';$('overlay').classList.remove('hidden');$('pause').textContent='继续'}else if(state==='paused')start()}function start(){if(state==='ended')reset();autoPaused=false;last=0;state='play';$('overlay').classList.add('hidden');$('pause').textContent='暂停';ui()}
function ui(){$('money').textContent=Math.floor(money);$('income').textContent='+'+(12+level*4)+' / 秒';$('time').textContent=String(Math.floor(elapsed/60)).padStart(2,'0')+':'+String(Math.floor(elapsed%60)).padStart(2,'0');['b','r'].forEach((s,i)=>{$(s+'h').textContent=Math.ceil(Math.max(0,bases[i]));$(s+'b').style.width=Math.max(0,bases[i]/20)+'%'});document.querySelectorAll('[data-type]').forEach(b=>b.disabled=state!=='play'||money<TYPES[+b.dataset.type].cost||spawnCD>0||units.filter(u=>!u.team).length>=60);$('upgrade').disabled=state!=='play'||level>=5||money<150+level*100;$('upcost').textContent=level>=5?'补给已满级':'◈ '+(150+level*100)+' · +4 / 秒';$('updesc').textContent='补给等级 '+level+' / 5';}
function update(dt){elapsed+=dt;spawnCD=Math.max(0,spawnCD-dt);money+=dt*(12+level*4);enemyMoney+=dt*(11+Math.min(14,elapsed/15));aiTimer-=dt;if(aiTimer<=0){aiTimer=1.4+Math.random()*1.8;let t=elapsed<12?0:Math.random()<.3?2:Math.random()<.5?1:0;if(enemyMoney>=TYPES[t].cost&&units.filter(u=>u.team).length<60){enemyMoney-=TYPES[t].cost;let l=Math.floor(Math.random()*3);spawn(1,t,l)}}for(const u of units){if(u.hp<=0)continue;u.cool-=dt;u.flash=Math.max(0,u.flash-dt);let target=null,dist=Infinity;for(const v of units){if(v.team===u.team||v.lane!==u.lane||v.hp<=0)continue;let d=Math.abs(v.x-u.x);if(d<dist){dist=d;target=v}}let baseX=u.team?95:1005,bd=Math.abs(baseX-u.x);if(dist<=u.range||bd<=u.range){if(u.cool<=0){u.cool=u.cd;let tx,ty;if(target&&dist<=u.range){target.hp-=u.damage;target.flash=.1;tx=target.x;ty=target.y}else{bases[1-u.team]-=u.damage;tx=baseX;ty=u.y}fx.push({x:u.x,y:u.y,tx,ty,life:.18,max:.18,team:u.team,type:u.type})}}else{let dir=u.team?-1:1;let blocked=units.some(v=>v!==u&&v.team===u.team&&v.lane===u.lane&&v.hp>0&&(v.x-u.x)*dir>0&&(v.x-u.x)*dir<(u.type===2?27:17));if(!blocked)u.x+=dir*u.speed*dt}}
units=units.filter(u=>{if(u.hp>0)return true;if(u.team){money+=9;kills++}fx.push({x:u.x,y:u.y,tx:u.x,ty:u.y,life:.4,max:.4,boom:true});return false});fx.forEach(f=>f.life-=dt);fx=fx.filter(f=>f.life>0);if(bases.some(v=>v<=0)){state='ended';const won=bases[1]<=0&&bases[0]>0;$('title').textContent=won?'蓝方胜利':'蓝方基地失守';$('intro').textContent='战斗用时 '+Math.floor(elapsed)+' 秒 · 击败 '+kills+' 个敌方单位';$('start').textContent='再战一局 →';$('overlay').classList.remove('hidden')}ui()}
function rect(x,y,w,h,color){g.fillStyle=color;g.fillRect(x,y,w,h)}function drawBase(team){let x=team?1005:95,col=team?'#ed796a':'#67bafa';g.fillStyle=team?'#503d35':'#304c52';g.beginPath();g.arc(x,235,90,0,Math.PI*2);g.fill();rect(x-40,175,80,130,'#172b31');rect(x-45,185,90,90,'#63746a');rect(x-35,192,70,76,'#2b3b40');rect(x-23,207,46,45,col);rect(x-14,214,28,31,'#233942');for(let yy=180;yy<301;yy+=110){rect(x-51,yy,24,26,'#869187');rect(x+27,yy,24,26,'#869187');rect(x-47,yy+5,16,8,col);rect(x+31,yy+5,16,8,col)}rect(x-2,144,3,36,'#b6c2af');rect(x+1,145,24,14,col);g.textAlign='center';g.fillStyle=col;g.font='bold 12px system-ui';g.fillText(team?'RED COMMAND':'BLUE COMMAND',x,342)}
function draw(){g.clearRect(0,0,1100,470);rect(0,0,1100,470,'#2c4138');for(let x=0;x<1100;x+=40)for(let y=0;y<470;y+=40){g.strokeStyle='#ffffff04';g.strokeRect(x,y,40,40)}rect(523,0,54,470,'#263e41');rect(536,0,27,470,'#355355');for(let i=0;i<3;i++){rect(110,ys[i]-25,880,50,'#51604b');rect(110,ys[i]-23,880,46,'#475744');rect(510,ys[i]-28,80,56,'#788271');for(let x=515;x<590;x+=12)rect(x,ys[i]-27,2,54,'#53614f');g.setLineDash([6,10]);g.strokeStyle='#b4c39a23';g.beginPath();g.moveTo(180,ys[i]);g.lineTo(920,ys[i]);g.stroke();g.setLineDash([])}for(let i=0;i<55;i++){let x=(i*193+37)%1100,y=(i*79+29)%470;if(y>120&&y<350)continue;rect(x,y,8,5,'#617053');rect(x+3,y-3,6,6,'#4c6048')}g.strokeStyle='#d6ec9b55';g.lineWidth=2;g.strokeRect(158,ys[lane]-26,335,52);g.lineWidth=1;drawBase(0);drawBase(1);for(const u of [...units].sort((a,b)=>a.y-b.y)){let color=u.flash?'#fff':u.team?'#f28070':'#76c7ff',dir=u.team?-1:1;g.fillStyle='#0004';g.beginPath();g.ellipse(u.x,u.y+11,u.type===2?20:10,6,0,0,Math.PI*2);g.fill();if(u.type===2){rect(u.x-19,u.y-12,38,8,'#1c292b');rect(u.x-19,u.y+7,38,8,'#1c292b');rect(u.x-17,u.y-7,34,17,color);rect(u.x-8,u.y-5,16,13,u.team?'#aa504b':'#3b85b2');rect(u.x,u.y-2,dir*28,5,color)}else{rect(u.x-6,u.y-4,12,14,color);rect(u.x-5,u.y-11,10,9,'#d5d5b8');rect(u.x-7,u.y-12,14,5,color);rect(u.x,u.y+1,dir*(u.type===1?19:11),3,'#14262c');rect(u.x-6,u.y+10,4,5,'#1b292e');rect(u.x+2,u.y+10,4,5,'#1b292e')}let w=u.type===2?34:22;rect(u.x-w/2,u.y-22,w,3,'#192c2e');rect(u.x-w/2,u.y-22,w*Math.max(0,u.hp/u.maxhp),3,color)}for(const f of fx){g.globalAlpha=f.life/f.max;if(f.boom){g.strokeStyle='#ffcb83';g.beginPath();g.arc(f.x,f.y,(1-f.life/f.max)*23+3,0,Math.PI*2);g.stroke()}else{g.strokeStyle=f.team?'#ffb49a':'#b4e6ff';g.lineWidth=f.type===2?3:1.5;g.beginPath();g.moveTo(f.x,f.y);g.lineTo(f.tx,f.ty);g.stroke();g.fillStyle='#fff1b5';g.fillRect(f.tx-3,f.ty-3,6,6)}g.globalAlpha=1;g.lineWidth=1}g.fillStyle='#b4c6aa';g.font='10px monospace';g.textAlign='center';g.fillText('N O R T H   R I D G E',550,48);g.fillText('S O U T H   F I E L D',550,426)}
$('start').onclick=start;$('pause').onclick=pause;$('restart').onclick=()=>{reset();start()};$('upgrade').onclick=upgrade;document.querySelectorAll('[data-type]').forEach(b=>b.onclick=()=>recruit(+b.dataset.type));document.querySelectorAll('[data-lane]').forEach(b=>b.onclick=()=>{lane=+b.dataset.lane;document.querySelectorAll('[data-lane]').forEach(x=>x.classList.toggle('active',x===b))});document.addEventListener('keydown',e=>{if(e.code==='Space'){e.preventDefault();pause()}if(['1','2','3'].includes(e.key))recruit(+e.key-1);if(e.key==='4')upgrade()});const SAVE='front-save-v1';
function saveGame(){try{if(state==='ended'||state==='ready'){localStorage.removeItem(SAVE);return}localStorage.setItem(SAVE,JSON.stringify({version:1,units,bases,money,enemyMoney,elapsed,aiTimer,lane,level,spawnCD,kills}))}catch{}}
function restoreGame(){try{const d=JSON.parse(localStorage.getItem(SAVE));if(!d||d.version!==1||!Array.isArray(d.units)||!Array.isArray(d.bases)||d.bases.length!==2||d.bases.some(v=>!Number.isFinite(v)||v<=0)||!['money','enemyMoney','elapsed','aiTimer','lane','level','spawnCD','kills'].every(k=>Number.isFinite(d[k])))return;units=d.units;bases=d.bases;money=d.money;enemyMoney=d.enemyMoney;elapsed=d.elapsed;aiTimer=d.aiTimer;lane=d.lane;level=d.level;spawnCD=d.spawnCD;kills=d.kills;fx=[];state='paused';$('title').textContent='发现未完成的战斗';$('intro').textContent='已保存部队、金币和基地血量，点击继续。';$('start').textContent='继续上次战斗 →';$('pause').textContent='继续';document.querySelectorAll('[data-lane]').forEach(b=>b.classList.toggle('active',+b.dataset.lane===lane));ui()}catch{}}
function suspend(){if(state==='play'){pause();autoPaused=true}saveGame();last=0}
function resume(){last=0;if(autoPaused&&state==='paused')start()}
document.addEventListener('visibilitychange',()=>{if(document.hidden)suspend();else resume()});
window.addEventListener('pagehide',suspend);window.addEventListener('pageshow',()=>{if(!document.hidden)resume()});
function frame(t){requestAnimationFrame(frame);let dt=last?Math.max(0,Math.min((t-last)/1000,.05)):0;last=t;if(state==='play'){update(dt);saveTimer+=dt;if(saveTimer>=1||state==='ended'){saveTimer=0;saveGame()}}draw()}
reset(false);restoreGame();requestAnimationFrame(frame);
</script></html>
